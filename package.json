{
  "name": "react-js-pagination",
  "version": "3.1.0",
  "description": "Simple, easy to use component for pagination. Compatible with bootstrap paginator stylesheets",
  "main": "./dist/Pagination.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && babel src/components --out-dir dist --extensions .jsx",
    "start": "vite example",
    "build-example": "vite build example",
    "lint": "eslint src test example",
    "typecheck": "tsc -p test/types",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:compat": "npm run build && node test/compat.cjs",
    "validate": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run validate && npm run build && node test/compat.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwwaiser/react-js-pagination.git"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/src/**/*.test.js"
    ]
  },
  "keywords": [
    "react",
    "reactjs",
    "pagination",
    "paginator",
    "bootstrap",
    "react-component"
  ],
  "author": "Sergey Vayser <wice24@gmail.com> (http://github.com/vayser)",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/wwwaiser/react-js-pagination/issues"
  },
  "homepage": "https://github.com/wwwaiser/react-js-pagination",
  "peerDependencies": {
    "react": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "paginator": "^1.0.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "bootstrap": "^5.3.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
